    "func": "// Suscripción de SOLO LECTURA. NodeId de la Server Interface del PLC.\nconst nodeId = env.get('SFT_DB100_NODEID');\nif (!nodeId || !/^ns=\\d+;[isgb]=/.test(nodeId)) {\n  node.warn('Configura SFT_DB100_NODEID con el NodeId real del DB100');\n  return null;\n}\nmsg.topic = nodeId;\nmsg.action = 'subscribe';\nmsg.payload = 1000; // intervalo de muestreo solicitado (ms)\nmsg.interval = 1000;\nmsg.queueSize = 10;\nreturn msg;",
