  {
    "id": "8ea0f1a97ad045d5",
    "type": "function",
    "z": "50ebc34c1c084c3f",
    "name": "Publicar estado OPC UA al monitor",
    "func": "const s=msg.status||{}; const src=s.source||{};\nmsg.method='POST';\nmsg.url=(env.get('SFT_MONITOR_URL')||((env.get('FASTAPI_BASE_URL')||'http://127.0.0.1:8000')+'/api/v1/node-red/events')).replace(/\\/$/,'');\nmsg.headers={'Content-Type':'application/json','X-Node-RED-Token':env.get('SFT_MONITOR_TOKEN')||env.get('NODE_RED_MONITOR_TOKEN')||''};\nmsg.payload={event:'opcua_node_status',level:s.fill==='red'?'error':'info',node_id:src.id||'',node_type:src.type||'OpcUa',node_name:src.name||'OPC UA',message:String(s.text||s.fill||'OPC UA status').slice(0,500),flow_name:'TIA Portal S7-1200 OPC UA',timestamp:new Date().toISOString()};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
