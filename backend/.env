# ============================================================================
# SCADA PID · Variables de Entorno (.env)
# ============================================================================

# --- Servidor Backend ---
APP_NAME="SCADA PID"
APP_VERSION="6.1.0"
HOST=0.0.0.0
PORT=8000

# --- Base de Datos: PostgreSQL (Primaria) con Fallback Automático a SQLite ---
DB_PREFERRED_ENGINE=postgres
DB_AUTO_FALLBACK_SQLITE=true

# URL completa opcional (ej: postgresql://usuario:clave@localhost:5432/scada_pid)
# Si se deja vacía, se construye con las variables POSTGRES_* de abajo.
DATABASE_URL=postgresql+psycopg://postgres.hocpstfvcqxgqfibvvua:scDsZ0BQi5H4GUyI@aws-0-us-west-2.pooler.supabase.com:5432/postgres

POSTGRES_HOST=aws-0-us-west-2.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=22_11_2026
POSTGRES_USER=postgres.hocpstfvcqxgqfibvvua
POSTGRES_PASSWORD=scDsZ0BQi5H4GUyI
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=2

# Base de datos SQLite local persistente (respaldo automático si PostgreSQL no responde)
SQLITE_DB_PATH=/home/user/data/scada_pid.db

# Persistencia periódica y retención máxima en base de datos
DB_TELEMETRY_SAVE_INTERVAL_S=5.0
DB_STATE_SAVE_INTERVAL_S=3.0
DB_MAX_TELEMETRY_ROWS=5000
DB_MAX_EVENT_ROWS=1000

# --- Valores Iniciales por Defecto de Operación y PID ---
DEFAULT_SETPOINT_MPS=1.40
DEFAULT_PID_PRESET=balanced

# --- Asistente IA (OpenAI -> Groq -> Gemini -> Ollama) ---
PREFERRED_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Búsqueda en Internet (Tavily -> DuckDuckGo) ---
WEB_SEARCH_MODE=always
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
