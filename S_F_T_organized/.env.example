# SCADA PID - plantilla segura
APP_NAME="SCADA PID"
APP_VERSION="6.1.0"
HOST=127.0.0.1
PORT=8000

DB_PREFERRED_ENGINE=sqlite
DB_AUTO_FALLBACK_SQLITE=true
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=scada_pid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=2
SQLITE_DB_PATH=./data/scada_pid.db
DB_TELEMETRY_SAVE_INTERVAL_S=5
DB_STATE_SAVE_INTERVAL_S=3
DB_MAX_TELEMETRY_ROWS=5000
DB_MAX_EVENT_ROWS=1000
DEFAULT_SETPOINT_MPS=1.40
DEFAULT_PID_PRESET=balanced

PREFERRED_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
WEB_SEARCH_MODE=always
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
