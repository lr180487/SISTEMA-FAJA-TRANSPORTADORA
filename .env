# ============================================================================
# SCADA PID · Variables de Entorno (.env)
# ============================================================================

# --- Servidor Backend ---
APP_NAME="SCADA PID"
APP_VERSION="6.1.0"
HOST=0.0.0.0
PORT=8000

# --- Base de Datos: PostgreSQL (Primaria) con Fallback Automático a SQLite ---
DB_PREFERRED_ENGINE=postgres
DB_AUTO_FALLBACK_SQLITE=true

# URL completa opcional (ej: postgresql://usuario:clave@localhost:5432/scada_pid)
# Si se deja vacía, se construye con las variables POSTGRES_* de abajo.
DATABASE_URL=postgresql+psycopg://postgres.hocpstfvcqxgqfibvvua:scDsZ0BQi5H4GUyI@aws-0-us-west-2.pooler.supabase.com:5432/postgres

POSTGRES_HOST=aws-0-us-west-2.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=22_11_2026
POSTGRES_USER=postgres.hocpstfvcqxgqfibvvua
POSTGRES_PASSWORD=scDsZ0BQi5H4GUyI
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=2

# Base de datos SQLite local persistente (respaldo automático si PostgreSQL no responde)
SQLITE_DB_PATH=/home/user/data/scada_pid.db

# Persistencia periódica y retención máxima en base de datos
DB_TELEMETRY_SAVE_INTERVAL_S=5.0
DB_STATE_SAVE_INTERVAL_S=3.0
DB_MAX_TELEMETRY_ROWS=5000
DB_MAX_EVENT_ROWS=1000

# --- Valores Iniciales por Defecto de Operación y PID ---
DEFAULT_SETPOINT_MPS=1.40
DEFAULT_PID_PRESET=balanced

# --- Asistente IA (OpenAI -> Groq -> Gemini -> Ollama) ---
PREFERRED_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Búsqueda en Internet (Tavily -> DuckDuckGo) ---
WEB_SEARCH_MODE=always
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
#
# Identidad técnica para Node-RED
NODERED_SERVICE_USERNAME=nr_admin
NODERED_SERVICE_PASSWORD=$2y$08$eq7Y.Xkgu3qNF5qDWiaCb.xNqy1cpCsekj0iwTXhey0TNOHRLBcgq


# Clave compartida para endpoints internos específicos
INTERNAL_API_KEY=GwyPtI3dgchwelIdcy6t5US2ItjZmHhlQLcisT06uQIBcO5IDKRp7eM-Xp3_2ByL

# Integración Node-RED
NODERED_WS_ENABLED=true
NODERED_WS_URL=ws://127.0.0.1:1880/industrial/events

# ngrok: expose FastAPI only, never PLC TCP/102 or Node-RED editor
NGROK_ENABLED=false
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Siemens S7-1200 CPU 1214C
PLC_ENABLED=false
PLC_WRITE_ENABLED=false
PLC_HOST=192.168.0.10
PLC_PORT=102
PLC_RACK=0
PLC_SLOT=1
PLC_DB_NUMBER=100
PLC_CONNECT_TIMEOUT_MS=3000
PLC_POLL_INTERVAL_SECONDS=1.0

# Full DB100 v2 tag map is embedded in app/core/config.py.
# Override only if TIA Portal offsets/types differ from this verified project map.
PLC_TAGS_JSON=

# Fail-closed: define engineering limits only after process/PLC owner approval.
# Example syntax (values below are intentionally blank/not configured):
# PLC_WRITE_LIMITS_JSON={"C1_SP_mm":{"min":MIN_ENGINEERING_VALUE,"max":MAX_ENGINEERING_VALUE}}
PLC_WRITE_LIMITS_JSON={}
PLC_WRITABLE_TAGS=C1_SP_mm,C2_SP_mm,C3_SP_mm

# FastAPI -> Node-RED WebSocket push. Node-RED must listen on this path.
NODERED_WS_ENABLED=false
NODERED_WS_URL=ws://127.0.0.1:1880/industrial/events

#
NODE_RED_MONITOR_TOKEN=Oa1szkNl82fwfNpreG7axpKqEiIFPRIxWmGyDiflIEE
NODE_RED_STALE_AFTER_S=30
